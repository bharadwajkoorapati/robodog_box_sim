<?xml version="1.0"?>
<robot name="ultrasonic_box_bot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ================= PROPERTIES ================= -->
  <xacro:property name="box_x" value="0.4"/>   <!-- length -->
  <xacro:property name="box_y" value="0.3"/>   <!-- width -->
  <xacro:property name="box_z" value="0.15"/>  <!-- height -->
  <xacro:property name="box_mass" value="5.0"/>

  <xacro:property name="wheel_radius" value="0.06"/>
  <xacro:property name="wheel_width" value="0.04"/>
  <xacro:property name="wheel_separation" value="0.34"/>
  <xacro:property name="wheel_mass" value="0.3"/>

  <xacro:property name="caster_radius" value="0.03"/>
  <xacro:property name="caster_mass" value="0.1"/>

  <xacro:property name="us_len" value="0.01"/>
  <xacro:property name="us_radius" value="0.008"/>
  <xacro:property name="us_range_min" value="0.02"/>
  <xacro:property name="us_range_max" value="4.0"/>
  <xacro:property name="us_fov" value="0.5235987756"/>

  <material name="grey">
    <color rgba="0.6 0.6 0.6 1.0"/>
  </material>
  <material name="black">
    <color rgba="0.05 0.05 0.05 1.0"/>
  </material>
  <material name="orange">
    <color rgba="1.0 0.4 0.0 1.0"/>
  </material>

  <!-- ================= INERTIA MACROS ================= -->
  <xacro:macro name="box_inertia" params="mass x y z z_offset">
    <inertial>
      <origin xyz="0 0 ${z_offset}" rpy="0 0 0"/>
      <mass value="${mass}"/>
      <inertia
        ixx="${mass/12.0*(y*y+z*z)}" ixy="0.0" ixz="0.0"
        iyy="${mass/12.0*(x*x+z*z)}" iyz="0.0"
        izz="${mass/12.0*(x*x+y*y)}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="cylinder_inertia" params="mass r h rpy:='0 0 0'">
    <inertial>
      <origin xyz="0 0 0" rpy="${rpy}"/>
      <mass value="${mass}"/>
      <inertia
        ixx="${mass/12.0*(3*r*r+h*h)}" ixy="0.0" ixz="0.0"
        iyy="${mass/12.0*(3*r*r+h*h)}" iyz="0.0"
        izz="${mass/2.0*r*r}"/>
    </inertial>
  </xacro:macro>

  <!-- ================= BASE LINK ================= -->
  <!-- base_footprint is on the ground plane (Z = 0) -->
  <link name="base_footprint"/>

  <!-- base_link origin is located at wheel axle height (Z = wheel_radius) -->
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <!-- Chassis box centered at Z = 0.035 gives 0.02m ground clearance -->
    <visual>
      <origin xyz="0 0 0.035" rpy="0 0 0"/>
      <geometry>
        <box size="${box_x} ${box_y} ${box_z}"/>
      </geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.035" rpy="0 0 0"/>
      <geometry>
        <box size="${box_x} ${box_y} ${box_z}"/>
      </geometry>
    </collision>
    <!-- Low center of mass for high dynamic stability -->
    <xacro:box_inertia mass="${box_mass}" x="${box_x}" y="${box_y}" z="${box_z}" z_offset="0.01"/>
  </link>

  <gazebo reference="base_link">
    <material>Gazebo/Grey</material>
  </gazebo>

  <!-- ================= WHEELS ================= -->
  <xacro:macro name="wheel" params="prefix reflect_y">
    <link name="${prefix}_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="black"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
      <xacro:cylinder_inertia mass="${wheel_mass}" r="${wheel_radius}" h="${wheel_width}" rpy="1.5708 0 0"/>
    </link>

    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_wheel_link"/>
      <origin xyz="${-box_x/4.0} ${reflect_y * (wheel_separation / 2.0)} 0.0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>

    <gazebo reference="${prefix}_wheel_link">
      <material>Gazebo/Black</material>
      <mu1>1.0</mu1>
      <mu2>1.0</mu2>
      <kp>1000000.0</kp>
      <kd>1.0</kd>
    </gazebo>
  </xacro:macro>

  <xacro:wheel prefix="left" reflect_y="1"/>
  <xacro:wheel prefix="right" reflect_y="-1"/>

  <!-- ================= FRONT CASTER WHEEL ================= -->
  <!-- Caster center is at Z = -0.03 relative to base_link (Z = 0.03 in base_footprint).
       Radius is 0.03m, so ground contact is exactly Z = 0.00m matching the drive wheels. -->
  <link name="caster_wheel_link">
    <visual>
      <geometry>
        <sphere radius="${caster_radius}"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <geometry>
        <sphere radius="${caster_radius}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="${caster_mass}"/>
      <inertia
        ixx="${2.0/5.0 * caster_mass * caster_radius * caster_radius}" ixy="0" ixz="0"
        iyy="${2.0/5.0 * caster_mass * caster_radius * caster_radius}" iyz="0"
        izz="${2.0/5.0 * caster_mass * caster_radius * caster_radius}"/>
    </inertial>
  </link>

  <joint name="caster_wheel_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_wheel_link"/>
    <origin xyz="${box_x/2.0 - caster_radius - 0.02} 0.0 ${-wheel_radius + caster_radius}" rpy="0 0 0"/>
  </joint>

  <gazebo reference="caster_wheel_link">
    <material>Gazebo/Black</material>
    <!-- Frictionless omni-directional contact to prevent anchor drag -->
    <mu1>0.001</mu1>
    <mu2>0.001</mu2>
    <kp>1000000.0</kp>
    <kd>1.0</kd>
  </gazebo>

  <!-- ================= ULTRASONIC SENSOR MACRO ================= -->
  <xacro:macro name="ultrasonic_sensor" params="name x y z yaw">
    <link name="${name}_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 1.5708 0"/>
        <geometry>
          <cylinder radius="${us_radius}" length="${us_len}"/>
        </geometry>
        <material name="orange"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 1.5708 0"/>
        <geometry>
          <cylinder radius="${us_radius}" length="${us_len}"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.01"/>
        <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
      </inertial>
    </link>

    <joint name="${name}_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${name}_link"/>
      <origin xyz="${x} ${y} ${z}" rpy="0 0 ${yaw}"/>
    </joint>

    <gazebo reference="${name}_link">
      <material>Gazebo/Orange</material>
      <sensor name="${name}" type="gpu_lidar">
        <pose>0 0 0 0 0 0</pose>
        <topic>${name}</topic>
        <gz_frame_id>${name}_link</gz_frame_id>
        <update_rate>10</update_rate>
        <always_on>true</always_on>
        <visualize>true</visualize>
        <lidar>
          <scan>
            <horizontal>
              <samples>5</samples>
              <resolution>1</resolution>
              <min_angle>${-us_fov/2.0}</min_angle>
              <max_angle>${us_fov/2.0}</max_angle>
            </horizontal>
            <vertical>
              <samples>1</samples>
              <resolution>1</resolution>
              <min_angle>0.0</min_angle>
              <max_angle>0.0</max_angle>
            </vertical>
          </scan>
          <range>
            <min>${us_range_min}</min>
            <max>${us_range_max}</max>
            <resolution>0.01</resolution>
          </range>
        </lidar>
      </sensor>
    </gazebo>
  </xacro:macro>

  <xacro:ultrasonic_sensor name="us_front" x="${box_x/2.0 + us_len/2.0}" y="0" z="0.035" yaw="0"/>
  <xacro:ultrasonic_sensor name="us_back"  x="${-(box_x/2.0 + us_len/2.0)}" y="0" z="0.035" yaw="3.14159"/>
  <xacro:ultrasonic_sensor name="us_left"  x="0" y="${box_y/2.0 + us_len/2.0}" z="0.035" yaw="1.5708"/>
  <xacro:ultrasonic_sensor name="us_right" x="0" y="${-(box_y/2.0 + us_len/2.0)}" z="0.035" yaw="-1.5708"/>

  <!-- ================= TOP-MOUNTED 2D LIDAR ================= -->
  <xacro:property name="lidar_radius" value="0.02"/>
  <xacro:property name="lidar_height" value="0.03"/>
  <xacro:property name="lidar_range_min" value="0.08"/>
  <xacro:property name="lidar_range_max" value="10.0"/>
  <xacro:property name="lidar_samples" value="361"/>

  <link name="lidar_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${lidar_radius}" length="${lidar_height}"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${lidar_radius}" length="${lidar_height}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/>
    </inertial>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0 0 ${0.035 + box_z/2.0 + lidar_height/2.0}" rpy="0 0 0"/>
  </joint>

  <gazebo reference="lidar_link">
    <material>Gazebo/Black</material>
    <sensor name="lidar" type="gpu_lidar">
      <pose>0 0 0 0 0 0</pose>
      <topic>scan</topic>
      <gz_frame_id>lidar_link</gz_frame_id>
      <update_rate>10</update_rate>
      <always_on>true</always_on>
      <visualize>true</visualize>
      <lidar>
        <scan>
          <horizontal>
            <samples>${lidar_samples}</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
          <vertical>
            <samples>1</samples>
            <resolution>1</resolution>
            <min_angle>0.0</min_angle>
            <max_angle>0.0</max_angle>
          </vertical>
        </scan>
        <range>
          <min>${lidar_range_min}</min>
          <max>${lidar_range_max}</max>
          <resolution>0.01</resolution>
        </range>
      </lidar>
    </sensor>
  </gazebo>

  <!-- ================= GAZEBO DIFF DRIVE PLUGIN ================= -->
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>${wheel_separation}</wheel_separation>
      <wheel_radius>${wheel_radius}</wheel_radius>
      <odom_publish_frequency>20</odom_publish_frequency>
      <!-- Command topic matches the ROS topic name because ros_gz_bridge uses
           one name for both sides. /cmd_vel_safe is the watchdog output, so
           Gazebo and ROS can never disagree about who owns the velocity. -->
      <topic>cmd_vel_safe</topic>
      <odom_topic>odom</odom_topic>
      <tf_topic>tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <max_linear_acceleration>1.0</max_linear_acceleration>
      <max_angular_acceleration>2.0</max_angular_acceleration>
      <min_linear_velocity>-0.25</min_linear_velocity>
      <max_linear_velocity>0.25</max_linear_velocity>
      <min_angular_velocity>-0.8</min_angular_velocity>
      <max_angular_velocity>0.8</max_angular_velocity>
    </plugin>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
    </plugin>
  </gazebo>

</robot>
