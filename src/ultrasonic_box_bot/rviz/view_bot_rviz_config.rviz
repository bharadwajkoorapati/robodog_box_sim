Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /RobotModel1
        - /TF1
        - /PointCloud21
      Splitter Ratio: 0.5
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 164
      Enabled: true
      Name: Grid
      Plane: XY
      Plane Cell Count: 20
    - Class: rviz_default_plugins/RobotModel
      Description Topic:
        Value: /robot_description
      Enabled: true
      Name: RobotModel
      Visual Enabled: true
      Collision Enabled: false
    - Class: rviz_default_plugins/TF
      Enabled: true
      Name: TF
      Show Names: true
      Show Axes: true
      Show Arrows: false
    - Class: rviz_default_plugins/LaserScan
      Enabled: true
      Name: us_front
      Topic:
        Value: /us_front
      Size (m): 0.03
      Color: 255; 0; 0
    - Class: rviz_default_plugins/LaserScan
      Enabled: true
      Name: us_back
      Topic:
        Value: /us_back
      Size (m): 0.03
      Color: 0; 255; 0
    - Class: rviz_default_plugins/LaserScan
      Enabled: true
      Name: us_left
      Topic:
        Value: /us_left
      Size (m): 0.03
      Color: 0; 0; 255
    - Class: rviz_default_plugins/LaserScan
      Enabled: true
      Name: us_right
      Topic:
        Value: /us_right
      Size (m): 0.03
      Color: 255; 255; 0
    - Class: rviz_default_plugins/LaserScan
      Enabled: true
      Name: lidar_scan
      Topic:
        Value: /scan
        Reliability Policy: Best Effort
      Size (m): 0.02
      Color: 255; 255; 255
    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: PointCloud2
      Topic:
        Value: /scan/points
        Reliability Policy: Best Effort
      Style: Points
      Size (m): 0.02
      Color Transformer: AxisColor
      Axis: Z
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: base_link
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 2.5
      Name: Current View
      Pitch: 0.5
      Yaw: 0.8
      Focal Point:
        X: 0
        Y: 0
        Z: 0
Window Geometry:
  Height: 900
  Width: 1400
  X: 60
  Y: 60
