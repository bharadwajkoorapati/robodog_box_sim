Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Map1
        - /RobotModel1
        - /TF1
        - /LaserScan5
      Splitter Ratio: 0.5
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    # --- Reference Grid ---
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 164
      Enabled: true
      Name: Grid
      Plane: XY
      Plane Cell Count: 20

    # --- SLAM Map ---
    - Class: rviz_default_plugins/Map
      Enabled: true
      Name: Map
      Topic:
        Value: /map
        Reliability Policy: Reliable
        Depth: 5
      Update Topic:
        Value: /map_updates
        Reliability Policy: Reliable
      Color Scheme: map
      Draw Under: true
      Alpha: 0.7

    # --- Global Costmap ---
    - Class: rviz_default_plugins/Map
      Enabled: true
      Name: Global Costmap
      Topic:
        Value: /global_costmap/costmap
        Reliability Policy: Reliable
      Color Scheme: costmap
      Alpha: 0.5
      Draw Under: false

    # --- Local Costmap ---
    - Class: rviz_default_plugins/Map
      Enabled: true
      Name: Local Costmap
      Topic:
        Value: /local_costmap/costmap
        Reliability Policy: Reliable
      Color Scheme: costmap
      Alpha: 0.4
      Draw Under: false

    # --- Robot Model ---
    - Class: rviz_default_plugins/RobotModel
      Description Topic:
        Value: /robot_description
      Enabled: true
      Name: RobotModel
      Visual Enabled: true
      Collision Enabled: false

    # --- TF Frames ---
    - Class: rviz_default_plugins/TF
      Enabled: true
      Name: TF
      Show Names: true
      Show Axes: true
      Show Arrows: false
      Marker Scale: 0.5

    # --- Nav2 Planned Path ---
    - Class: rviz_default_plugins/Path
      Enabled: true
      Name: Nav2 Plan
      Topic:
        Value: /plan
        Reliability Policy: Reliable
      Color: 0; 200; 255

    # --- Nav2 Local Plan ---
    - Class: rviz_default_plugins/Path
      Enabled: true
      Name: Local Plan
      Topic:
        Value: /local_plan
        Reliability Policy: Reliable
      Color: 255; 170; 0

    # --- 2D LiDAR Scan ---
    - Class: rviz_default_plugins/LaserScan
      Enabled: true
      Name: lidar_scan
      Topic:
        Value: /scan
        Reliability Policy: Best Effort
      Size (m): 0.025
      Color: 255; 255; 255

    # --- Ultrasonic Sensors ---
    - Class: rviz_default_plugins/LaserScan
      Enabled: true
      Name: us_front
      Topic:
        Value: /us_front
      Size (m): 0.04
      Color: 255; 0; 0

    - Class: rviz_default_plugins/LaserScan
      Enabled: true
      Name: us_back
      Topic:
        Value: /us_back
      Size (m): 0.04
      Color: 0; 255; 0

    - Class: rviz_default_plugins/LaserScan
      Enabled: true
      Name: us_left
      Topic:
        Value: /us_left
      Size (m): 0.04
      Color: 0; 0; 255

    - Class: rviz_default_plugins/LaserScan
      Enabled: true
      Name: us_right
      Topic:
        Value: /us_right
      Size (m): 0.04
      Color: 255; 255; 0

    # --- LiDAR Point Cloud ---
    - Class: rviz_default_plugins/PointCloud2
      Enabled: false
      Name: PointCloud2
      Topic:
        Value: /scan/points
        Reliability Policy: Best Effort
      Style: Points
      Size (m): 0.02
      Color Transformer: AxisColor
      Axis: Z

  Enabled: true
  Global Options:
    Background Color: 30; 30; 35
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: nav2_rviz_plugins/GoalTool
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Top-Down Map View
      Scale: 80
      X: 2
      Y: -2
Window Geometry:
  Height: 1080
  Width: 1920
  X: 60
  Y: 60
