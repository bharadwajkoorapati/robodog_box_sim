<?xml version="1.0"?>
<robot name="ultrasonic_box_bot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ================= PROPERTIES ================= -->
  <xacro:property name="box_x" value="0.4"/>   <!-- length -->
  <xacro:property name="box_y" value="0.3"/>   <!-- width -->
  <xacro:property name="box_z" value="0.15"/>  <!-- height -->
  <xacro:property name="box_mass" value="5.0"/>
  <xacro:property name="wheel_radius" value="0.05"/>
  <xacro:property name="wheel_width" value="0.03"/>
  <xacro:property name="wheel_mass" value="0.2"/>

  <xacro:property name="us_len" value="0.01"/>
  <xacro:property name="us_radius" value="0.008"/>
  <xacro:property name="us_range_min" value="0.02"/>
  <xacro:property name="us_range_max" value="4.0"/>
  <xacro:property name="us_fov" value="0.26"/> <!-- ~15 deg cone in radians -->
  <xacro:property name="lidar_fov" value="3.14159"/> <!-- ~180 deg in radians -->
  <xacro:property name="lidar_range_max" value="7.0"/>

  <material name="grey">
    <color rgba="0.6 0.6 0.6 1.0"/>
  </material>
  <material name="black">
    <color rgba="0.05 0.05 0.05 1.0"/>
  </material>
  <material name="orange">
    <color rgba="1.0 0.4 0.0 1.0"/>
  </material>

  <!-- ================= INERTIA MACROS ================= -->
  <xacro:macro name="box_inertia" params="mass x y z">
    <inertial>
      <mass value="${mass}"/>
      <inertia
        ixx="${mass/12.0*(y*y+z*z)}" ixy="0.0" ixz="0.0"
        iyy="${mass/12.0*(x*x+z*z)}" iyz="0.0"
        izz="${mass/12.0*(x*x+y*y)}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="cylinder_inertia" params="mass r h">
    <inertial>
      <mass value="${mass}"/>
      <inertia
        ixx="${mass/12.0*(3*r*r+h*h)}" ixy="0.0" ixz="0.0"
        iyy="${mass/12.0*(3*r*r+h*h)}" iyz="0.0"
        izz="${mass/2.0*r*r}"/>
    </inertial>
  </xacro:macro>

  <!-- ================= BASE LINK ================= -->
  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${box_x} ${box_y} ${box_z}"/>
      </geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${box_x} ${box_y} ${box_z}"/>
      </geometry>
    </collision>
    <xacro:box_inertia mass="${box_mass}" x="${box_x}" y="${box_y}" z="${box_z}"/>
  </link>

  <!-- ================= WHEELS ================= -->
  <xacro:macro name="wheel" params="prefix reflect_y">
    <link name="${prefix}_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="black"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
      <xacro:cylinder_inertia mass="${wheel_mass}" r="${wheel_radius}" h="${wheel_width}"/>
    </link>

    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_wheel_link"/>
      <origin xyz="${-box_x/4.0} ${reflect_y*(box_y/2.0 + wheel_width/2.0)} ${-box_z/2.0}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>

  </xacro:macro>

  <xacro:wheel prefix="left" reflect_y="1"/>
  <xacro:wheel prefix="right" reflect_y="-1"/>

  <!-- Rear caster -->
  <link name="caster_wheel_link">
    <visual>
      <geometry>
        <sphere radius="${wheel_radius/2.0}"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <geometry>
        <sphere radius="${wheel_radius}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="caster_wheel_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_wheel_link"/>
    <origin xyz="${(box_x/2.0 - wheel_radius/2.0)} 0 ${-(wheel_radius/2.0 + box_z/2.0 - wheel_radius/4.0)}" rpy="0 0 0"/>
  </joint>


  <!-- ================= ULTRASONIC SENSOR MACRO ================= -->
  <xacro:macro name="ultrasonic_sensor" params="name x y z yaw">
    <link name="${name}_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 1.5708 0"/>
        <geometry>
          <cylinder radius="${us_radius}" length="${us_len}"/>
        </geometry>
        <material name="orange"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 1.5708 0"/>
        <geometry>
          <cylinder radius="${us_radius}" length="${us_len}"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.01"/>
        <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
      </inertial>
    </link>

    <joint name="${name}_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${name}_link"/>
      <origin xyz="${x} ${y} ${z}" rpy="0 0 ${yaw}"/>
    </joint>
  </xacro:macro>

  <xacro:ultrasonic_sensor name="us_front" x="${box_x/2.0 + us_len/2.0}" y="0" z="${box_z/4.0}" yaw="0"/>
  <xacro:ultrasonic_sensor name="us_back"  x="${-(box_x/2.0 + us_len/2.0)}" y="0" z="${box_z/4.0}" yaw="3.14159"/>
  <xacro:ultrasonic_sensor name="us_left"  x="0" y="${box_y/2.0 + us_len/2.0}" z="${box_z/4.0}" yaw="1.5708"/>
  <xacro:ultrasonic_sensor name="us_right" x="0" y="${-(box_y/2.0 + us_len/2.0)}" z="${box_z/4.0}" yaw="-1.5708"/>

  <!-- ================= TOP-MOUNTED 2D LIDAR ================= -->
  <xacro:property name="lidar_radius" value="0.02"/>
  <xacro:property name="lidar_height" value="0.03"/>
  <xacro:property name="lidar_range_min" value="0.08"/>
  <xacro:property name="lidar_range_max" value="10.0"/>
  <xacro:property name="lidar_samples" value="361"/>

  <link name="lidar_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${lidar_radius}" length="${lidar_height}"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${lidar_radius}" length="${lidar_height}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/>
    </inertial>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0 0 ${box_z/2.0 + lidar_height/2.0}" rpy="0 0 0"/>
  </joint>


    <ros2_control name="MujocoSystem" type="system">
    <hardware>
      <plugin>mujoco_ros2_control/MujocoSystemInterface</plugin>

      <!-- Absolute path is used initially for reliable debugging. -->
      <param name="mujoco_model">
        /home/shadowb/ros2_ws/src/ultrasonic_box_bot_description/config/rover.xml
      </param>
    </hardware>

    <joint name="left_wheel_joint">
      <command_interface name="velocity">
        <param name="min">-20.0</param>
        <param name="max">20.0</param>
      </command_interface>

      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="right_wheel_joint">
      <command_interface name="velocity">
        <param name="min">-20.0</param>
        <param name="max">20.0</param>
      </command_interface>

      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

</robot>
