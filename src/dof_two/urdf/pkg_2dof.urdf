<?xml version="1.0"?>
<robot name="dof_two" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg
    name="controller_config"
    default="$(find dof_two)/config/controllers.yaml"/>

  <!-- ========================================================= -->
  <!-- Root                                                        -->
  <!-- ========================================================= -->

  <link name="root"/>


  <!-- ========================================================= -->
  <!-- Ground                                                      -->
  <!-- ========================================================= -->

  <link name="ground">

    <inertial>
      <origin xyz="0 0 0.0125" rpy="0 0 0"/>
      <mass value="2.0"/>
      <inertia
        ixx="0.001042"
        ixy="0.0"
        ixz="0.0"
        iyy="0.001042"
        iyz="0.0"
        izz="0.001667"/>
    </inertial>

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh
          filename="package://dof_two/meshes/Ground.stl"
          scale="1 1 1"/>
      </geometry>
      <material name="ground_visual">
        <color rgba="0.615686 0.811765 0.929412 1.0"/>
      </material>
    </visual>

    <!-- Ground collision approximation -->
    <collision>
      <origin xyz="0 0 0.0125" rpy="0 0 0"/>
      <geometry>
        <box size="0.20 0.20 0.025"/>
      </geometry>
    </collision>

  </link>


  <!-- ========================================================= -->
  <!-- Base                                                        -->
  <!-- ========================================================= -->

  <link name="base">

    <inertial>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <mass value="0.5"/>
      <inertia
        ixx="0.000729"
        ixy="0.0"
        ixz="0.0"
        iyy="0.000729"
        iyz="0.0"
        izz="0.001250"/>
    </inertial>

    <visual>
      <origin xyz="-0.075 0.005 0" rpy="0 0 0"/>
      <geometry>
        <mesh
          filename="package://dof_two/meshes/Base.stl"
          scale="1 1 1"/>
      </geometry>
      <material name="base_visual">
        <color rgba="0.341176 0.776471 0.741176 1.0"/>
      </material>
    </visual>

    <!-- Base collision approximation -->
    <collision>
      <origin xyz="-0.075 0.005 0.05" rpy="0 0 0"/>
      <geometry>
        <box size="0.15 0.10 0.10"/>
      </geometry>
    </collision>

  </link>


  <!-- ========================================================= -->
  <!-- First moving link                                           -->
  <!-- ========================================================= -->

  <link name="links">

    <inertial>
      <origin xyz="-0.0138881 -0.005 0.0480325"
              rpy="0 -0.281463 0"/>
      <mass value="0.5"/>
      <inertia
        ixx="0.000867"
        ixy="0.0"
        ixz="0.000210"
        iyy="0.001062"
        iyz="0.0"
        izz="0.000203"/>
    </inertial>

    <visual>
      <origin xyz="-0.0148653 0 0.0436021"
              rpy="0 -0.281463 0"/>
      <geometry>
        <mesh
          filename="package://dof_two/meshes/Links.stl"
          scale="1 1 1"/>
      </geometry>
      <material name="links_visual">
        <color rgba="0.372549 0.654902 0.239216 1.0"/>
      </material>
    </visual>

    <!-- First link collision approximation -->
    <collision>
      <origin xyz="-0.0148653 0 0.0436021"
              rpy="0 -0.281463 0"/>
      <geometry>
        <box size="0.055 0.035 0.10"/>
      </geometry>
    </collision>

  </link>


  <!-- ========================================================= -->
  <!-- Second moving link                                          -->
  <!-- ========================================================= -->

  <link name="links_1">

    <inertial>
      <origin xyz="0 -0.005 0.05" rpy="0 0 0"/>
      <mass value="0.5"/>
      <inertia
        ixx="0.000926"
        ixy="0.0"
        ixz="0.0"
        iyy="0.001062"
        iyz="0.0"
        izz="0.000142"/>
    </inertial>

    <visual>
      <origin xyz="-0.00216937 0 0.0460153"
              rpy="0 0 0"/>
      <geometry>
        <mesh
          filename="package://dof_two/meshes/Links.stl"
          scale="1 1 1"/>
      </geometry>
      <material name="links_1_visual">
        <color rgba="0.372549 0.654902 0.239216 1.0"/>
      </material>
    </visual>

    <!-- Second link collision approximation -->
    <collision>
      <origin xyz="-0.00216937 0 0.0460153"
              rpy="0 0 0"/>
      <geometry>
        <box size="0.055 0.035 0.10"/>
      </geometry>
    </collision>

  </link>


  <!-- ========================================================= -->
  <!-- End effector                                                -->
  <!-- ========================================================= -->

  <link name="endeffector">

    <inertial>
      <origin xyz="0 0.005 0" rpy="0 0 0"/>
      <mass value="0.15"/>
      <inertia
        ixx="0.000010"
        ixy="0.0"
        ixz="0.0"
        iyy="0.000010"
        iyz="0.0"
        izz="0.000010"/>
    </inertial>

    <visual>
      <origin xyz="0 0.005 -0.005" rpy="0 0 0"/>
      <geometry>
        <mesh
          filename="package://dof_two/meshes/EndEffector.stl"
          scale="1 1 1"/>
      </geometry>
      <material name="endeffector_visual">
        <color rgba="0.615686 0.811765 0.929412 1.0"/>
      </material>
    </visual>

    <!-- End-effector collision approximation -->
    <collision>
      <origin xyz="0 0.005 -0.005" rpy="0 0 0"/>
      <geometry>
        <box size="0.025 0.025 0.025"/>
      </geometry>
    </collision>

  </link>


  <!-- ========================================================= -->
  <!-- Fixed root-to-ground joint                                  -->
  <!-- ========================================================= -->

  <joint name="fixed_node_to_root_joint" type="fixed">

    <origin xyz="-3.38271e-17 -2.77556e-17 -0.025"
            rpy="0 0 0"/>

    <parent link="root"/>
    <child link="ground"/>

  </joint>


  <!-- ========================================================= -->
  <!-- Fixed ground-to-base joint                                  -->
  <!-- ========================================================= -->

  <joint name="fastened_1" type="fixed">

    <origin xyz="3.38271e-17 2.77556e-17 0.025"
            rpy="0 0 0"/>

    <parent link="ground"/>
    <child link="base"/>

  </joint>


  <!-- ========================================================= -->
  <!-- Base-to-first-moving-link joint                             -->
  <!-- ========================================================= -->

  <joint name="revolute_2" type="revolute">

    <origin xyz="-1.63064e-16 -0.005 0.1"
            rpy="0 0 0"/>

    <axis xyz="0 1 0"/>

    <parent link="base"/>
    <child link="links"/>

    <limit
      effort="10"
      velocity="1"
      lower="-1.28933"
      upper="1.85226"/>

    <dynamics
      damping="0.2"
      friction="0.1"/>

  </joint>


  <!-- ========================================================= -->
  <!-- First-to-second moving-link joint                          -->
  <!-- ========================================================= -->

  <joint name="revolute_1" type="revolute">

    <origin xyz="-0.0277761 -0.01 0.096065"
            rpy="-3.14159 -1.28936 3.14159"/>

    <axis xyz="0 1 0"/>

    <parent link="links"/>
    <child link="links_1"/>

    <limit
      effort="10"
      velocity="1"
      lower="-2.21911e-05"
      upper="3.14157"/>

    <dynamics
      damping="0.2"
      friction="0.1"/>

  </joint>


  <!-- ========================================================= -->
  <!-- Fixed second-link-to-end-effector joint                     -->
  <!-- ========================================================= -->

  <joint name="fastened_2" type="fixed">

    <origin xyz="-0.005 -0.005 0.135"
            rpy="0 -1.5708 4.71239"/>

    <parent link="links_1"/>
    <child link="endeffector"/>

  </joint>


  <!-- ========================================================= -->
  <!-- Gazebo contact parameters                                   -->
  <!-- ========================================================= -->

  <gazebo reference="ground">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
  </gazebo>

  <gazebo reference="base">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
  </gazebo>

  <gazebo reference="links">
    <mu1>0.8</mu1>
    <mu2>0.8</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
  </gazebo>

  <gazebo reference="links_1">
    <mu1>0.8</mu1>
    <mu2>0.8</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
  </gazebo>

  <gazebo reference="endeffector">
    <mu1>0.8</mu1>
    <mu2>0.8</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
  </gazebo>

    <!-- ========================================================= -->
  <!-- ros2_control interface for Gazebo Harmonic                 -->
  <!-- ========================================================= -->

  <ros2_control name="DofTwoSystem" type="system">

    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>

    <joint name="revolute_1">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="revolute_2">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

  </ros2_control>

  <!-- Gazebo loads the ros2_control plugin -->
  <gazebo>
    <plugin
      filename="libgz_ros2_control-system.so"
      name="gz_ros2_control::GazeboSimROS2ControlPlugin">

      <parameters>$(arg controller_config)</parameters>
    </plugin>
  </gazebo>

</robot>